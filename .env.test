# Secrets and connection strings are intentionally left empty in this committed file.
# Real values live in the untracked .env.test.local (see README, "Running tests").
KERNEL_CLASS='App\Kernel'
# Any non-empty string for the test environment; set in .env.test.local
APP_SECRET=
# PostgreSQL DSN for the test database, e.g. postgresql://app:app_secret@127.0.0.1:5432/app_test?serverVersion=16&charset=utf8
DATABASE_URL=
