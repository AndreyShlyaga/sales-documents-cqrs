# Secrets and connection strings are intentionally left empty in this committed file.
# Real values live in the untracked .env.local (see README, "Setup").

###> symfony/framework-bundle ###
APP_ENV=dev
# 32-char random hex string; generate locally and set in .env.local
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL used to generate absolute links, e.g. http://localhost; set in .env.local
DEFAULT_URI=
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# PostgreSQL DSN, credentials from compose.yaml; set in .env.local
# e.g. postgresql://app:app_secret@127.0.0.1:5432/app?serverVersion=16&charset=utf8
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
